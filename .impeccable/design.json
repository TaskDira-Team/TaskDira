      "description": "Raised teal action with a compressed press state.",
      "html": "<button class=\"ds-primary\">Start a quest</button>",
      "css": ".ds-primary{font:900 15px 'Nunito Variable',sans-serif;background:#27b697;color:#103f35;border:2px solid #138c73;border-radius:17px;box-shadow:0 5px 0 #138c73;min-height:46px;padding:10px 18px;cursor:pointer;transition:transform 170ms,background 170ms,box-shadow 170ms}.ds-primary:hover{background:#4ec6aa;transform:translateY(-2px)}.ds-primary:active{transform:translateY(3px);box-shadow:0 1px 0 #138c73}.ds-primary:focus-visible{outline:3px solid #8150b5;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;animation:none}}"
