      "description": "A reward object and price on an open toy shelf, without a enclosing card.",
      "html": "<article class=\"ds-shelf\"><div class=\"ds-shelf-art\"><span class=\"ds-shelf-prize\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z\"/></svg></span><span class=\"ds-shelf-price\">50 coins</span></div><h3 class=\"ds-shelf-title\">Movie night</h3><p class=\"ds-shelf-copy\">A household reward to work toward.</p><button class=\"ds-redeem\">Redeem reward</button></article>",
      "css": ".ds-shelf{max-width:300px;background:transparent;color:#244c49;font-family:'Nunito Variable',sans-serif}.ds-shelf-art{position:relative;display:flex;align-items:center;justify-content:center;min-height:180px}.ds-shelf-art:before{content:'';position:absolute;width:170px;height:140px;bottom:8px;border-radius:48% 52% 43% 57%;background:#dfcafa;transform:rotate(-7deg)}.ds-shelf-art:after{content:'';position:absolute;bottom:0;width:90%;height:12px;background:#e5c9a7;border-radius:99px;box-shadow:0 7px 0 #c7a683,0 15px 16px #694f3520}.ds-shelf-prize{position:relative;z-index:1;transform:rotate(-7deg);color:#9b7028;transition:transform 260ms cubic-bezier(.2,.8,.2,1)}.ds-shelf-prize svg{width:91px;height:91px;fill:#ffe796}.ds-shelf:hover .ds-shelf-prize{transform:translateY(-9px) rotate(3deg)}.ds-shelf-price{position:absolute;inset-inline-end:6px;top:4px;z-index:2;padding:10px 16px;background:#ffdf72;color:#744500;border:3px solid #fff6c1;border-radius:22px;box-shadow:0 4px 0 #d39a32;font:600 20px 'Fredoka Variable',sans-serif;transform:rotate(8deg)}.ds-shelf-title{font:550 24px 'Fredoka Variable',sans-serif;margin:25px 8px 0}.ds-shelf-copy{font-size:14px;line-height:1.6;color:#526963;margin:9px 8px 18px}.ds-redeem{width:100%;min-height:48px;border:0;border-radius:18px;padding:12px 15px;background:#18715d;color:white;font:900 16px 'Nunito Variable',sans-serif;box-shadow:0 5px 0 #105141;cursor:pointer;transition:transform 170ms,box-shadow 170ms}.ds-redeem:hover{background:#20836a;transform:translateY(-2px);box-shadow:0 7px 0 #105141}.ds-redeem:active{transform:translateY(3px);box-shadow:0 2px 0 #105141}@media(prefers-reduced-motion:reduce){.ds-shelf-prize{transition:none}}.ds-redeem:focus-visible{outline:3px solid #8150b5;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-redeem{transition:none;animation:none}}"
    },
    {
      "name": "Quest Checkpoint",
      "kind": "custom",
      "refersTo": "quest-checkpoint",
      "description": "Round actionable quest piece with a shine and numbered tab.",
      "html": "<div class=\"ds-stop\"><button class=\"ds-checkpoint\" aria-label=\"Open quest: Tidy the room\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z\"/></svg><span class=\"ds-shine\"></span><span class=\"ds-number\">1</span></button><strong class=\"ds-task-title\">Tidy the room</strong></div>",
      "css": ".ds-stop{display:flex;flex-direction:column;align-items:center;padding:10px 12px 16px;gap:14px;font:900 14px 'Nunito Variable',sans-serif;color:#244c49}.ds-checkpoint{position:relative;display:grid;place-items:center;width:85px;height:79px;background:#45c6a2;color:#eaffee;border:4px solid #91e3c6;border-radius:50%;box-shadow:0 8px 0 #199775,0 13px 0 #e1dfc3;cursor:pointer;transition:transform 170ms,box-shadow 170ms}.ds-checkpoint svg{width:34px;height:34px;z-index:1}.ds-checkpoint:hover{transform:translateY(-4px) rotate(-7deg);box-shadow:0 12px 0 #199775,0 17px 0 #e1dfc3}.ds-checkpoint:active{transform:translateY(5px);box-shadow:0 3px 0 #199775,0 8px 0 #e1dfc3}.ds-shine{position:absolute;width:42px;height:16px;top:6px;inset-inline-start:13px;border-radius:50%;background:#b8f5d8;opacity:.45;transform:rotate(-15deg)}.ds-number{position:absolute;bottom:-6px;inset-inline-end:-3px;background:#fffceb;border:2px solid #c7e0a9;border-radius:50%;width:24px;height:24px;font:950 11px 'Nunito Variable',sans-serif;color:#406449;display:grid;place-items:center}.ds-task-title{max-width:190px;text-align:center}.ds-checkpoint:focus-visible{outline:3px solid #8150b5;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-checkpoint{transition:none;animation:none}}"
    },
    {
      "name": "Shiny Wallet Coin",
      "kind": "custom",
      "refersTo": "coin",
      "description": "Informational coin token paired with an explicit spendable-balance label.",
      "html": "<div class=\"ds-wallet\"><span class=\"ds-coin\" aria-hidden=\"true\">★</span><strong>120</strong><span>coins available</span></div>",
      "css": ".ds-wallet{display:flex;align-items:center;gap:8px;color:#9a6806;font:900 14px 'Nunito Variable',sans-serif}.ds-wallet strong{font-size:18px;font-variant-numeric:tabular-nums}.ds-coin{display:inline-grid;place-items:center;background:#ffd34a;color:#956001;width:24px;height:24px;border-radius:50%;border:3px solid #ffe991;box-shadow:0 3px 0 #da9d22,0 0 0 1px #dea632;font-size:14px;line-height:1}"
    }
  ],
  "narrative": {
    "northStar": "The Chore Adventure Toy World",
    "overview": "TaskDira is a deliberately childish, colourful household game: oversized shiny coins, chunky checkpoints, wiggly trails, toy-shop shelves and a friendly original companion. The visual ambition is the delight of a kids' App Store game, with the winding-road clarity of Duolingo, expressed through TaskDira's own home, mascot and palette.\n\nOpen compositions let objects, paths and characters carry the hierarchy. The user explicitly rejected a boxed-component look; ordinary statistics, graphs, rewards and member content sit directly on the cream world. Tactile controls and functional dialogs retain their own clear boundaries. The public miniature home, account entry and signed-in household all inhabit the same playful world.",
    "keyCharacteristics": [
      "Cream canvases with teal, coral, lilac and yellow toy colours.",
      "Shiny collectible coins and separate lifetime XP.",
      "Round checkpoints, dotted trails and open toy shelves.",
      "Fredoka display lettering, Nunito body text and Hebrew support.",
      "An original companion, a miniature 3D home and purposeful game feedback."
    ],
    "rules": [
      {
        "name": "The Open World Rule",
        "body": "Put routine content on the canvas; reserve enclosed surfaces for controls, inputs, temporary dialogs and intentional scenes.",
        "section": "elevation"
      },
      {
        "name": "The Two Treasures Rule",
        "body": "Gold coins represent spendable balance; lilac XP represents accumulated progress. Keep the labels and data distinct.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do give quests, milestones and rewards recognizable physical forms and clear actions.",
      "Do keep ordinary graphs, statistics and reward shelves open on the cream canvas.",
      "Do label coins as spendable balance and XP as lifetime progress.",
      "Do use the original mascot asset at Frontend/public/images/dira-mascot.png.",
      "Do preserve native controls, visible focus, EN/HE directionality and reduced-motion support.",
      "Do show only real account progress; clearly label the public playground and local sample data."
    ],
    "donts": [
      "Don't return to a corporate dashboard of bordered cards.",
      "Don't replace the selected palette with the former purple/neon dark theme.",
      "Don't imply that decorative milestone paths impose sequential unlock rules.",
      "Don't make motion, colour or a 3D canvas the sole way to understand or operate the product.",
      "Don't invent activity, adoption figures or reward balances."
    ]
  }
}
